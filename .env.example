NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=
INWORLD_API_KEY=
INWORLD_VOICE_ID=
# OpenAI gpt-4o-mini-tts. GPT_VOICE_ID is one of:
# alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
GPT_API_KEY=
GPT_VOICE_ID=
# Cartesia Sonic. CARTESIA_VOICE_ID takes either a voice name from the library
# ("Jameson") or its UUID; unset means Jameson. CARTESIA_MODEL_ID overrides the
# model when Cartesia ships a newer Sonic.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=
# ElevenLabs. The voice takes a name ("Roger") or its id; the model defaults to
# eleven_multilingual_v2. ELVENLABS_* is accepted for both, as the dashboard
# spells it that way.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
