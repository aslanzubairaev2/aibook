{
  "name": "aibook",
  "version": "1.0.0",
  "description": "Mobile-first AI language learning book reader",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib scripts *.ts *.mjs",
    "test:vocab": "node --experimental-strip-types --test lib/text/vocab.test.ts",
    "test:crop": "node --experimental-strip-types --test components/capture/imageCrop.test.ts",
    "test:videos": "node --experimental-strip-types --import ./scripts/register-test-loader.mjs --test lib/videos/videos.test.ts lib/videos/transcript.test.ts lib/videos/training.test.ts",
    "test": "node scripts/run-tests.mjs",
    "test:critical": "node scripts/run-tests.mjs --critical",
    "check:schema": "node scripts/check-dictionary-schema.mjs",
    "prebuild": "npm test"
  },
  "proxy": "http://192.168.178.55:3000",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.105.4",
    "@workflow/next": "^4.1.13",
    "epubjs": "^0.3.93",
    "franc-min": "^6.2.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "workflow": "^4.8.9"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "ws": "^8.21.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "serialize-javascript": "7.0.5"
  }
}
